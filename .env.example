# Environment Variables Template

# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to version control!

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Base URL for the application (publicly safe)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB connection string
# Server-side (recommended): MONGO_URI
# Client-side (fallback): NEXT_PUBLIC_MONGO_URI
# Local MongoDB: mongodb://localhost:27017/cendeki-app
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/cendeki-app?retryWrites=true&w=majority
MONGO_URI="mongodb://localhost:27017/cendeki-app"
NEXT_PUBLIC_MONGO_URI="mongodb://localhost:27017/cendeki-app"

# MongoDB database name (defaults to Final_Project if not specified)
MONGO_DB_NAME="Final_Project"

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# JWT Secret (server-side only - NOT exposed to client)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# Google OAuth 2.0 credentials
# Server-side (recommended): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# Client-side (fallback): NEXT_PUBLIC_GG_ID, NEXT_PUBLIC_GG_SECRET
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
NEXT_PUBLIC_GG_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GG_SECRET="your-google-client-secret-here"

# ===========================================
# AI SERVICE API KEYS
# ===========================================

# OpenAI API Key (for ChatGPT features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# OpenRouter API Key (alternative AI service)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
NEXT_PUBLIC_OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Rapid API Key (if using external APIs)
# Get from: https://rapidapi.com/hub
NEXT_PUBLIC_RAPID_API_KEY="your-rapid-api-key-here"

# ===========================================
# ENVIRONMENT VARIABLE SECURITY NOTES
# ===========================================

# SERVER-ONLY SECRETS (Never use NEXT_PUBLIC_ prefix):
# - JWT_SECRET: Authentication tokens
# - GOOGLE_CLIENT_SECRET: OAuth secret
# - MONGO_URI: Database connection string
# - OPENAI_API_KEY: AI service key

# CLIENT-SAFE VARIABLES (Can use NEXT_PUBLIC_ prefix):
# - NEXT_PUBLIC_BASE_URL: Application URL
# - NEXT_PUBLIC_GG_ID: OAuth client ID (public)
# - NEXT_PUBLIC_OPENROUTER_API_KEY: If client-side access needed

# ===========================================
# DEVELOPMENT NOTES
# ===========================================

# 1. Replace all placeholder values with your actual API keys
# 2. Ensure JWT_SECRET is at least 32 characters long
# 3. For production, use different values than development
# 4. Test all API keys before deploying
# 5. Keep this file secure and never share it

# ===========================================
# SECURITY REMINDERS
# ===========================================

# - Never commit this file to Git
# - Use different keys for each environment
# - Rotate keys periodically
# - Monitor API usage and costs
# - Use strong, unique secrets

# ===========================================
# QUICK SETUP COMMANDS
# ===========================================

# Generate strong JWT secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Test MongoDB connection:
# mongosh "your-connection-string"

# Verify environment variables:
# node -e "console.log('Environment variables loaded:', Object.keys(process.env).filter(k => k.includes('NEXT_PUBLIC')).sort())"
