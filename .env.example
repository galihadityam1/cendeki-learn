# Environment Variables Template

# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Never commit .env.local to version control!

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB connection string
# Local MongoDB: mongodb://localhost:27017/cendeki-app
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/cendeki-app?retryWrites=true&w=majority
NEXT_PUBLIC_MONGO_URI="mongodb://localhost:27017/cendeki-app"

# ===========================================
# AI SERVICE API KEYS
# ===========================================

# OpenAI API Key (for ChatGPT features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# OpenRouter API Key (alternative AI service)
# Get from: https://openrouter.ai/keys
NEXT_PUBLIC_OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# ===========================================
# OAUTH CONFIGURATION (Google)
# ===========================================

# Google OAuth 2.0 credentials
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GG_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GG_SECRET="your-google-client-secret-here"

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Rapid API Key (if using external APIs)
# Get from: https://rapidapi.com/hub
NEXT_PUBLIC_RAPID_API_KEY="your-rapid-api-key-here"

# ===========================================
# DEVELOPMENT NOTES
# ===========================================

# 1. Replace all placeholder values with your actual API keys
# 2. Ensure NEXTAUTH_SECRET is at least 32 characters long
# 3. For production, use different values than development
# 4. Test all API keys before deploying
# 5. Keep this file secure and never share it

# ===========================================
# SECURITY REMINDERS
# ===========================================

# - Never commit this file to Git
# - Use different keys for each environment
# - Rotate keys periodically
# - Monitor API usage and costs
# - Use strong, unique secrets

# ===========================================
# QUICK SETUP COMMANDS
# ===========================================

# Generate strong JWT secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Test MongoDB connection:
# mongosh "your-connection-string"

# Verify environment variables:
# node -e "console.log('Environment variables loaded:', Object.keys(process.env).filter(k => k.includes('NEXT_PUBLIC')).sort())"
